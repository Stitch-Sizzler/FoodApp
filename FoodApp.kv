<CategoryColumns>:
    orientation: "horizontal"
    MDRectangleFlatButton:
        text: "Name"
        text_color: app.theme_cls.primary_color
        line_color: app.theme_cls.primary_color
        size_hint: 1, None
        pos_hint: {"top": 1}
        height: "30dp"
        on_release: app.selection_sort(0)

    MDRectangleFlatButton:
        text: "Category"
        text_color: app.theme_cls.primary_color
        line_color: app.theme_cls.primary_color
        size_hint: 1, None
        pos_hint: {"top": 1}
        height: "30dp"
        on_release: app.selection_sort(1)

    MDRectangleFlatButton:
        text: "Expiry Date"
        text_color: app.theme_cls.primary_color
        line_color: app.theme_cls.primary_color
        size_hint: 1, None
        pos_hint: {"top": 1}
        height: "30dp"
        on_release: app.selection_sort(2)


<FoodList>:
    orientation: "vertical"


# Screen where the user inputs their food name, category, expiration date, and quantity
<FoodInputScreen>:
    name: "input_screen"
    MDRelativeLayout:

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                title: "Add Item"
                pos_hint: {"top": 1}
                size_hint: 1, None
                elevation: "4dp"
                left_action_items: [["arrow-left", lambda x: root.manager.return_to("catalog")]]
                right_action_items: [["home", lambda x: root.manager.return_to("menu")]]

            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primary_color
                    text: "Item Details"
                    size_hint: 1, 0.5
                    font_size: "20sp"
                    halign: "center"

                MDTextField:
                    id: name_field
                    hint_text: "Enter Food Name"
                    text: "Item"
                    helper_text: "Max 12 characters"
                    # helper_text_mode: "on_error"
                    required: True
                    max_text_length: 12
                    icon_right: "food-apple"
                    icon_right_color: app.theme_cls.primary_color
                    size_hint: 0.7, None
                    height: "25dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    padding: "10dp", "10dp", "10dp", "30dp"

                MDTextField:
                    id: category_field
                    hint_text: "Enter Category Name"
                    text: "Category"
                    helper_text: "Max 12 characters"
                    # helper_text_mode: "on_error"
                    required: True
                    max_text_length: 12
                    icon_right: "food"
                    icon_right_color: app.theme_cls.primary_color
                    size_hint: 0.7, None
                    height: "25dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    padding: "10dp", "10dp", "10dp", "30dp"

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: 0.7, None
                    height: "60dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    MDTextField:
                        id: expiry_date_field
                        hint_text: "Expiry Date"
                        text: app.get_current_date()
                        helper_text: "Invalid Date (mm/dd/yyyy)"
                        helper_text_mode: "on_error"
                        validator: "date"
                        date_format: "mm/dd/yyyy"
                        required: True
                        size_hint: 0.7, None
                        height: "25dp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        padding: "10dp", "10dp", "10dp", "30dp"

                    MDIconButton:
                        icon: "calendar"
                        icon_color: app.theme_cls.primary_color
                        adaptive_size: True
                        icon_size: "55sp"
                        size_hint: 0.5, 1
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        theme_icon_color: "Custom"
                        icon_color: app.theme_cls.primary_color
                        on_release:
                            app.show_date_picker()

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: 0.7, None
                    height: "60dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    MDTextField:
                        id: quantity_field
                        hint_text: "Qty"
                        text: str(int(quantity_slider.value))
                        helper_text: "Integer Required"
                        helper_text_mode: "on_error"
                        required: True
                        #icon_right: "numeric"
                        #icon_right_color: app.theme_cls.primary_color
                        size_hint: 0.3, None
                        height: "10dp"
                        pos_hint: {"x": 0, "center_y": 0.5}
                        padding: "10dp", "10dp", "10dp", "30dp"

                    MDSlider:
                        id: quantity_slider
                        size_hint: 1.1, None
                        hint: False
                        height: "10dp"
                        pos_hint: {"center_y": 0.5}
                        text_elevation: 0
                        min: 1
                        max: 10.1
                        value: 1

                MDRelativeLayout:
                    MDRectangleFlatButton:
                        size: root.width, root.height
                        text: "Add"
                        text_color: "#ffffff"
                        md_bg_color: app.theme_cls.primary_color
                        size_hint: 0.5, 0.1
                        pos_hint: {"center_x": 0.5, "center_y":0.5}
                        on_release:
                            root.add_item(self, name_field.text, category_field.text, expiry_date_field.text, quantity_field.text)


# Screen where the user can edit their items. Very similar to the FoodInputScreen.
<EditScreen>:
    name: "edit_screen"
    MDRelativeLayout:

        MDBoxLayout:
            orientation: "vertical"

            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primary_color
                    text: "Edit Item Details"
                    size_hint: 1, 0.5
                    font_size: "20sp"
                    halign: "center"

                MDTextField:
                    id: name_field
                    hint_text: "Enter Food Name"
                    text: "Item"
                    helper_text: "Max 12 characters"
                    # helper_text_mode: "on_error"
                    required: True
                    max_text_length: 12
                    icon_right: "food-apple"
                    icon_right_color: app.theme_cls.primary_color
                    size_hint: 0.7, None
                    height: "25dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    padding: "10dp", "10dp", "10dp", "30dp"

                MDTextField:
                    id: category_field
                    hint_text: "Enter Category Name"
                    text: "Category"
                    helper_text: "Max 12 characters"
                    # helper_text_mode: "on_error"
                    required: True
                    max_text_length: 12
                    icon_right: "food"
                    icon_right_color: app.theme_cls.primary_color
                    size_hint: 0.7, None
                    height: "25dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    padding: "10dp", "10dp", "10dp", "30dp"

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: 0.7, None
                    height: "60dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    MDTextField:
                        id: expiry_date_field
                        hint_text: "Expiry Date"
                        text: app.get_current_date()
                        helper_text: "Invalid Date (mm/dd/yyyy)"
                        helper_text_mode: "on_error"
                        validator: "date"
                        date_format: "mm/dd/yyyy"
                        required: True
                        size_hint: 0.7, None
                        height: "25dp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        padding: "10dp", "10dp", "10dp", "30dp"

                    MDIconButton:
                        icon: "calendar"
                        icon_color: app.theme_cls.primary_color
                        adaptive_size: True
                        icon_size: "55sp"
                        size_hint: 0.5, 1
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        theme_icon_color: "Custom"
                        icon_color: app.theme_cls.primary_color
                        on_release:
                            app.show_date_picker()

                MDRelativeLayout:
                    MDRectangleFlatButton:
                        size: root.width, root.height
                        text: "Save"
                        text_color: "#ffffff"
                        md_bg_color: app.theme_cls.primary_color
                        size_hint: 0.5, 0.1
                        pos_hint: {"center_x": 0.5, "center_y":0.5}
                        on_release:
                            app.root.get_screen("edit_screen").del_and_edit()
                            app.root.get_screen("input_screen").add_item(self, name_field.text, category_field.text, expiry_date_field.text, str(1))

                    MDRectangleFlatButton:
                        size: root.width, root.height
                        text: "Cancel"
                        text_color: app.theme_cls.primary_color
                        line_color: app.theme_cls.primary_color
                        size_hint: 0.5, 0.1
                        pos_hint: {"center_x": 0.5, "center_y":0.3}
                        on_release: root.manager.return_to("catalog")


# Screen from where the user can select their app colour palette
<ThemeSelect>:
    name: "theme_select"

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Choose Theme"
            pos_hint: {"top": 1}
            size_hint: 1, None
            elevation: "4dp"
            left_action_items: [["arrow-left", lambda x: root.manager.return_to("menu")]]

        MDScrollView:
            Themes:
                size_hint: 1, None
                height: self.minimum_height
